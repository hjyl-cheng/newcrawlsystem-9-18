[Unit]
Description=Crawler PostgreSQL encrypted daily differential backup
Wants=network-online.target
After=network-online.target
[Service]
Type=oneshot
User=pgbackrest
Group=pgbackrest
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ExecStart=/usr/bin/pgbackrest --stanza=crawler --type=diff backup
TimeoutStartSec=2h
NoNewPrivileges=true
PrivateTmp=true
