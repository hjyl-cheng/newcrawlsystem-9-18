{
  "name": "crawl-publication-validation",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",
    "database.hostname": "postgres-rw.crawl-validation.svc",
    "database.port": "5432",
    "database.user": "crawl_cdc_validation",
    "database.password": "${file:/etc/kafka-secrets/database.properties:password}",
    "database.dbname": "crawler",
    "database.sslmode": "disable",
    "plugin.name": "pgoutput",
    "slot.name": "crawl_cdc_validation",
    "slot.failover": "true",
    "slot.drop.on.stop": "false",
    "publication.name": "crawl_cdc_validation",
    "publication.autocreate.mode": "disabled",
    "table.include.list": "cdc_validation\\.outbox",
    "topic.prefix": "crawl_cdc_validation",
    "snapshot.mode": "initial",
    "heartbeat.interval.ms": "5000",
    "tombstones.on.delete": "false",
    "include.schema.changes": "false",
    "max.batch.size": "128",
    "max.queue.size": "512",
    "poll.interval.ms": "500",
    "errors.tolerance": "none",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "transforms": "outbox",
    "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
    "transforms.outbox.route.topic.replacement": "crawler.publication.validation.v1",
    "transforms.outbox.table.expand.json.payload": "true",
    "transforms.outbox.table.field.event.timestamp": "created_at",
    "transforms.outbox.table.fields.additional.placement": "type:header:eventType",
    "transforms.outbox.predicate": "IsOutbox",
    "predicates": "IsOutbox",
    "predicates.IsOutbox.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
    "predicates.IsOutbox.pattern": "crawl_cdc_validation\\.cdc_validation\\.outbox",
    "name": "crawl-publication-validation"
  }
}
