{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:newcrawlsystem:data-plane:1-draft.1",
  "title": "Worker / Data Ingestor common envelope, first implementation draft",
  "description": "Metadata only. Does not prove payload integrity, authorization, durability or business completion.",
  "oneOf": [
    { "$ref": "#/$defs/submission" },
    { "$ref": "#/$defs/receiptQuery" },
    { "$ref": "#/$defs/receiptObservation" },
    { "$ref": "#/$defs/receipt" },
    { "$ref": "#/$defs/problem" },
    { "$ref": "#/$defs/frame" }
  ],
  "$defs": {
    "version": { "const": "data-plane/1-draft.1" },
    "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$" },
    "counter": { "type": "string", "maxLength": 20, "pattern": "^(0|[1-9][0-9]*)$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "byteCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_id", "channel_id", "logical_batch_key", "submission_id"],
      "properties": {
        "plan_id": { "$ref": "#/$defs/id" },
        "channel_id": { "$ref": "#/$defs/id" },
        "logical_batch_key": { "$ref": "#/$defs/id" },
        "submission_id": { "$ref": "#/$defs/id" }
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "execution_epoch"],
      "properties": {
        "scope": { "$ref": "#/$defs/id" },
        "execution_epoch": { "$ref": "#/$defs/counter" }
      }
    },
    "frozenInput": {
      "type": "object", "additionalProperties": false,
      "required": ["generation", "input_revision", "input_hash", "target_hash", "policy_version"],
      "properties": {
        "generation": { "$ref": "#/$defs/counter" },
        "input_revision": { "$ref": "#/$defs/counter" },
        "input_hash": { "$ref": "#/$defs/sha256" },
        "target_hash": { "$ref": "#/$defs/sha256" },
        "policy_version": { "$ref": "#/$defs/id" }
      }
    },
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_id", "hash_profile", "content_sha256", "wire_sha256", "uncompressed_bytes", "wire_bytes", "compression", "location"],
      "properties": {
        "schema_id": { "$ref": "#/$defs/id" },
        "hash_profile": { "const": "jcs-sha256-v1" },
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "wire_sha256": { "$ref": "#/$defs/sha256" },
        "uncompressed_bytes": { "$ref": "#/$defs/byteCount" },
        "wire_bytes": { "$ref": "#/$defs/byteCount" },
        "compression": { "enum": ["none", "gzip"] },
        "location": {
          "oneOf": [
            {
              "type": "object", "additionalProperties": false,
              "required": ["kind", "frame_count"],
              "properties": {
                "kind": { "const": "stream" },
                "frame_count": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
              }
            },
            {
              "type": "object", "additionalProperties": false,
              "required": ["kind", "bucket", "object_key"],
              "properties": {
                "kind": { "const": "object" },
                "bucket": { "$ref": "#/$defs/id" },
                "object_key": { "$ref": "#/$defs/id" }
              }
            }
          ]
        }
      }
    },
    "submission": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "kind", "identity", "producer_role", "execution", "frozen_input", "mode", "created_at", "payload"],
      "properties": {
        "contract_version": { "$ref": "#/$defs/version" },
        "kind": { "const": "SUBMISSION_MANIFEST" },
        "identity": { "$ref": "#/$defs/identity" },
        "producer_role": { "enum": ["fullcrawl", "incremental"] },
        "execution": { "$ref": "#/$defs/execution" },
        "frozen_input": { "$ref": "#/$defs/frozenInput" },
        "mode": { "enum": ["bootstrap_snapshot", "delta", "repair"] },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "payload": { "$ref": "#/$defs/payload" }
      }
    },
    "receiptQuery": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "kind", "identity", "expected_content_sha256"],
      "properties": {
        "contract_version": { "$ref": "#/$defs/version" },
        "kind": { "const": "RECEIPT_QUERY" },
        "identity": { "$ref": "#/$defs/identity" },
        "expected_content_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "receiptObservation": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "kind", "identity", "expected_content_sha256", "status", "observed_at"],
      "properties": {
        "contract_version": { "$ref": "#/$defs/version" },
        "kind": { "const": "RECEIPT_OBSERVATION" },
        "identity": { "$ref": "#/$defs/identity" },
        "expected_content_sha256": { "$ref": "#/$defs/sha256" },
        "status": { "const": "NOT_OBSERVED" },
        "observed_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "kind", "identity", "content_sha256", "receipt_id", "status", "recorded_at"],
      "properties": {
        "contract_version": { "$ref": "#/$defs/version" },
        "kind": { "const": "SUBMISSION_RECEIPT" },
        "identity": { "$ref": "#/$defs/identity" },
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "receipt_id": { "$ref": "#/$defs/id" },
        "status": { "enum": ["RECEIVED", "APPLIED"] },
        "recorded_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "problem": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "kind", "occurrence_id", "code", "recorded_at"],
      "properties": {
        "contract_version": { "$ref": "#/$defs/version" },
        "kind": { "const": "SUBMISSION_PROBLEM" },
        "occurrence_id": { "$ref": "#/$defs/id" },
        "identity": { "$ref": "#/$defs/identity" },
        "code": { "enum": ["AUTHZ.EXECUTION_STALE", "CTRL.CAPACITY_UNAVAILABLE", "CONTRACT.INVALID", "CONTRACT.VERSION_UNSUPPORTED", "IDEMPOTENCY.PAYLOAD_CONFLICT", "DB.COMMIT_UNKNOWN", "DATA.VERSION_CONFLICT", "OBJECT.HASH_MISMATCH"] },
        "recorded_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "frame": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "kind", "submission_id", "part_index", "wire_offset", "wire_bytes", "wire_sha256"],
      "properties": {
        "contract_version": { "$ref": "#/$defs/version" },
        "kind": { "const": "FRAME_DESCRIPTOR" },
        "submission_id": { "$ref": "#/$defs/id" },
        "part_index": { "type": "integer", "minimum": 0, "maximum": 2147483646 },
        "wire_offset": { "$ref": "#/$defs/byteCount" },
        "wire_bytes": { "$ref": "#/$defs/byteCount" },
        "wire_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
